# Genera valores seguros con: python scripts/configure.py
SECRET_KEY=replace-with-a-generated-long-secret
POSTGRES_PASSWORD=replace-with-a-generated-database-password
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=America/Chicago
APP_PORT=8000
# Producción: DEBUG=0, HTTPS, dominios permitidos y CSRF_TRUSTED_ORIGINS.
# TRUST_PROXY=1 únicamente si un proxy controlado sobrescribe X-Forwarded-Proto.
